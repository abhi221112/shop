# Leave empty for the website (it calls /api on the same domain).
# For the Android APK set it to where your API is reachable from the phone, e.g.
#   VITE_API_URL=https://shop.example.com        (production)
#   VITE_API_URL=http://192.168.1.20:8080        (your PC on the same Wi-Fi, docker compose running)
VITE_API_URL=
