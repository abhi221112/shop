# Copy to .env and fill in. Used by `docker compose up`.

SHOP_NAME=My Vegetable Shop
SHOP_PHONE=
SHOP_ADDRESS=
SHOP_TIMEZONE=Asia/Kolkata

# Your mobile number: log in with it to open the admin panel.
ADMIN_PHONE=9999999999

# Change both before going live (any long random string).
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=shop

# Delivery rules
DELIVERY_FEE=20
# Free delivery amount, free gift, first-order offer, referral reward: set in Admin › Offers.
SLOT_CUTOFF_HOURS=2
# Delivery slots can be set between these hours (24 = midnight).
SLOTS_FROM=5
SLOTS_UNTIL=24
# Comma-separated pincodes you deliver to. Empty = all.
SERVICE_PINCODES=

# true = login codes appear on screen and in the API log (no SMS needed). Set false once SMS is connected.
OTP_DEV_MODE=true

# UPI payments. Leave empty to use the built-in test payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set to production once JWT_SECRET is changed.
ENV=development
WEB_PORT=8080

# Public address of the shop, used in "Refer a friend" share links.
SHOP_URL=http://localhost:8080
